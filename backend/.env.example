APP_NAME=Birchscents
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# CORS origin + Paystack callback base
FRONTEND_URL=http://localhost:3000

# Logs to stderr in production so Coolify captures container logs (CLAUDE.md §14)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — Supabase today (use the "Session pooler" connection),
# self-hosted later (CLAUDE.md §7, §11). Migration = swap the DB_* block.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Stateless API: no Laravel sessions, no DB-backed cache/queue tables.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Supabase Auth — Project Settings → API → JWT Secret (HS256). Phase 7.
SUPABASE_JWT_SECRET=

# Paystack — test keys locally, live keys only in production. Phase 9.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@birchscents.com"
MAIL_FROM_NAME="${APP_NAME}"
